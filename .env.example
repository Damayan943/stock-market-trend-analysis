# Copy this file to .env and update the server/driver details for your machine.
# Example for local SQL Server with ODBC Driver 18 (adjust server and authentication):
SQLSERVER_CONNECTION_STRING=mssql+pyodbc://@localhost/StockMarketAnalysis?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
